# Generic LAH environment variables.
# Use only the values relevant to each worker.

LOCAL_AI_BACKEND=openwebui

OPENWEBUI_URL=http://127.0.0.1:3000
OPENWEBUI_API_KEY=replace-me

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=1024

GPT4ALL_URL=http://127.0.0.1:4891/v1

LOCAL_AI_DEFAULT_MODEL=
LOCAL_AI_RESEARCH_MODEL=

# Search is independent from inference.
# Values: openwebui | none
SEARCH_BACKEND=openwebui
SEARCH_OPENWEBUI_URL=http://127.0.0.1:3000
SEARCH_OPENWEBUI_API_KEY=

LOCAL_AI_MODEL_CACHE_TTL_SEC=15
LOCAL_AI_HTTP_TIMEOUT_SEC=180
LOCAL_AI_LOCK_WAIT_TIMEOUT_SEC=300
LOCAL_AI_MAX_AUTO_QUERIES=4
LOCAL_AI_DEFAULT_SEARCH_RESULTS=6
LOCAL_AI_MAX_SEARCH_RESULTS=10
LOCAL_AI_MAX_RESEARCH_ROUNDS=2
LOCAL_AI_MAX_TOTAL_RESEARCH_RESULTS=10

# IMPORTANT: one mutex name = one inference lane.
# Workers that must serialize should share a mutex name.
# Workers on independent compute should use different names.
LOCAL_AI_MUTEX_NAME=Local\CodexLocalAIInference
